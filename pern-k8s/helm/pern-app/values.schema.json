{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "namespace": { "type": "string" },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": { "type": "string" },
        "replicas": { "type": "integer", "minimum": 0 }
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": { "type": "string" },
        "replicas": { "type": "integer", "minimum": 0 }
      }
    },
    "postgres": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": { "type": "string" },
        "storage": { "type": "string" },
        "user": { "type": "string" },
        "existingSecret": { "type": "string", "minLength": 1 },
        "database": { "type": "string" },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "clusterIP": { "type": "string" }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "className": { "type": "string" },
        "host": { "type": "string" }
      }
    }
  }
}
